# AI Smart Shopping Assistant
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Protect sensitive files
<FilesMatch "(^config\.php$|\.lock$|\.sql$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
